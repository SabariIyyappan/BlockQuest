# Copy to .env and fill in on hackathon day.
# Every value here is optional — the backend runs fully offline without them.

# --- Memory backend: "local" (markdown stand-in) or "everos" (Linux/Docker only) ---
BQ_MEMORY_BACKEND=local
BQ_MEMORY_DIR=./memory_data

# --- Analytics sink: "jsonl" (local file) or "snowflake" ---
BQ_ANALYTICS_SINK=jsonl
BQ_TELEMETRY_DIR=./telemetry_data

# --- Snowflake (Phase 4) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=BLOCKQUEST
SNOWFLAKE_SCHEMA=PUBLIC

# --- Demo safety ---
# When true, /session-summary falls back to cached numbers if the warehouse is slow.
BQ_SUMMARY_FALLBACK=true
