# Copy to .env and fill in on hackathon day.
# Every value here is optional — the backend runs fully offline without them.

# --- Memory backend: "local" (markdown stand-in) or "everos" (Linux/Docker only) ---
BQ_MEMORY_BACKEND=local
BQ_MEMORY_DIR=./memory_data

# --- EverOS (Phase 3, Docker only) ---
BQ_EVEROS_APP_ID=blockquest
BQ_EVEROS_PROJECT_ID=tutor
# keyword | vector | hybrid | agentic.
# Only "keyword" works without an LLM/embedding key, so it is the safe default.
BQ_EVEROS_SEARCH_METHOD=keyword
BQ_EVEROS_TOP_K=20

# EverOS's own settings (note: EVEROS_ prefix, not BQ_).
# Leave blank and EverOS buffers messages instead of extracting them —
# retrieval still works off unprocessed_messages, it just skips the semantics.
EVEROS_ROOT=./memory_data
EVEROS_API_KEY=
EVEROS_BASE_URL=

# --- Analytics sink: "jsonl" (local file) or "snowflake" ---
BQ_ANALYTICS_SINK=jsonl
BQ_TELEMETRY_DIR=./telemetry_data

# --- Snowflake (Phase 4) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=BLOCKQUEST
SNOWFLAKE_SCHEMA=PUBLIC
# Optional when your account requires an explicit role.
SNOWFLAKE_ROLE=

# --- Demo safety ---
# When true, /session-summary falls back to cached numbers if the warehouse is slow.
BQ_SUMMARY_FALLBACK=true
